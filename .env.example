# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Master's Telegram chat_id (for notifications)
MASTER_CHAT_ID=your_master_chat_id_here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Google Calendar
# Path to service account JSON file (or JSON string for Railway)
GOOGLE_CREDENTIALS_JSON=path/to/credentials.json
CALENDAR_SLOTS_ID=your_slots_calendar_id@group.calendar.google.com
CALENDAR_BOOKINGS_ID=your_bookings_calendar_id@group.calendar.google.com

# AI module
AI_ENABLED=false
# AI provider: openai or gigachat
AI_PROVIDER=openai

# OpenAI (used when AI_PROVIDER=openai)
# Model: gpt-4o-mini
#   — достаточно умён для intent/datetime/faq задач этого бота
#   — в ~10x дешевле gpt-4o при сопоставимом качестве на коротких structured-output задачах
#   — низкая латентность (важно для UX в Telegram)
OPENAI_API_KEY=your_openai_api_key_here

# GigaChat (used when AI_PROVIDER=gigachat)
# Model: GigaChat
#   — базовая модель линейки Sber: быстрая и дешёвая, достаточна для structured-output задач бота
#   — данные не покидают российскую инфраструктуру (актуально для compliance)
#   — не требует VPN в отличие от OpenAI
# Credentials — base64(client_id:client_secret) из личного кабинета https://developers.sber.ru/
GIGACHAT_CREDENTIALS=your_gigachat_credentials_here
